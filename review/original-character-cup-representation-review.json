    "object_paste_description": "Paste copies of objects, as Cubism's copy and paste: meshes, warp and rotation deformers with their descendants, parts with their contents, and parameters. Copies keep keyforms, blend shapes, masks, paths, vertex groups and the glue between copied meshes, share the original's texture and layer, and reference other copies in place of their originals; a copied parameter is a new axis with the original's range and no keyforms. Swings, simulations and interior effects are not copied. New IDs are fixed when the paste is recorded and returned in ids; the deform paths copied with the meshes in paths. One undoable history edit.",
    "object_paste_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque state from workspace_inspect or the preceding result. Includes load generation and durable version; history node IDs are not state tokens."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 128,
          "description": "Copied objects as kind:id (mesh, warp, rotation, part, parameter). A deformer brings its descendant deformers and meshes, a part its child parts, meshes and the deformers organized in it."
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "warp:ID, rotation:ID or root: the deformer the pasted meshes and deformers hang under. Meshes keep where they show (space canvas); deformers keep their local geometry. Default: the originals' parent."
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "description": "part:ID or root: where the pasted objects sit in the parts tree. Default: right after each original."
        },
        "parameter_group": {
          "type": "string",
          "minLength": 1,
          "description": "param_group:ID or root for pasted parameters. Default: right after each original."
        },
        "ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "New IDs by source kind:id, fixed in advance. Others are the source ID with _copy, then _copy_2, ... - the first one free."
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique request ID. Retry unchanged arguments with this ID to recover the same result; use a new ID for a new attempt."
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Current project_id from workspace_inspect; null only when no project is loaded."
        }
      },
      "required": [
        "state",
        "sources",
        "request_id",
        "project_id"
      ]
    },
    "release_source": {
      "RigObjectPaste.kt": {
        "url": "https://github.com/tsunehimatoi/psd2live/blob/bfadd8343774d5b6208146060c4fa175d84a0f4f/src/main/kotlin/io/github/psd2live/core/RigObjectPaste.kt",
        "sha256": "a4aeeb62becb88da44860864aaa6c60935f7b3152c8ddae49c1d2bf5f1bace49"
      },
      "RigMeshDuplication.kt": {
        "url": "https://github.com/tsunehimatoi/psd2live/blob/bfadd8343774d5b6208146060c4fa175d84a0f4f/src/main/kotlin/io/github/psd2live/core/RigMeshDuplication.kt",
        "sha256": "9d077eeb9905aec0ff63539118dfab4c59b6100fcdd4950cc43c3138243753e4"
      }
    },
    "current_test_contract": {
      "group_syntax": "tests/hand_cup_contract.py64 permits nonempty distinct list cup IDs, but behavior below is stronger than just list syntax.",
      "visibility": "tests/hand_cup_metamorphic_check.py227-230 requires every cup-group mesh visible>0 in detached shown state then0 when hidden.",
      "detached_root": "tests/hand_cup_measurements.py196 requires complete vertices+opacity of every cup-group mesh unchanged under Body/Breath in Hold0, including opacity0 meshes. A hidden held instance inherited from body violates this.",
      "hold_no_visibility_switch": "tests/hand_cup_measurements.py198 explicitly requires each cup mesh opacity identical and>0 between Hold0/Hold1, to reject substituting a visibility switch for real coupling."
    }
  },
  "mathematical_inference": {
    "conditional_validity": "If neutral source input points of held-cup and palms coincide under the same BodyXY->BodyLean->BodyZBreath map, all shoulder/elbow/wrist inputs remain neutral, and no extra mesh-local Body shapes exist, inherited continuous body mapping removes the need to fit composed six-axis outputs. Live palm axes are empty and the required common chain was observed.",
    "mesh_barycentric_caveat": "Warp acts on mesh vertices. Equal rest barycentric positions in differently tessellated meshes need not remain equal under nonlinear warp. Insert same contact positions as actual vertices in cup and both palms and rebind actual Core triangles; keep1px tolerance.",
    "rotation_chain_caveat": "Default joint chains neutralized in rest are a precondition. If either arm/wrist moves while Hold1, body-only held-cup parent cannot follow both hands.",
    "nonrigid_cup": "Sharing spatially nonlinear body warp may deform cup itself. It preserves common points, not rigid physical cup shape; actual GL artwork review required."
  },
  "copy_api_assessment": {
    "supported": "object_paste copies mesh, shares original texture/layer, preserves keyforms and references, optional explicit parent does canvas-space bind.",
    "not_equivalent": "mesh_duplicate only transfers topology to an already existing target mesh and samples its own artwork; not object creation.",
    "audit_required": "Actual new MOC must prove source texture/UV preservation, correct rest placement, intended parent scope and no copied stale Hold fitting grid/manual artifacts."
  },
  "risks": {
    "linear_crossfade": "Two opacity branches alphaHeld=h and alphaFree=1-h create separated ghost cups when poses differ; even perfectly coincident opaque cups composite to alpha=1-h(1-h), only0.75 at h0.5.",
    "hard_switch": "Requires same world position/shape at handoff to avoid a jump and explicit handling of arbitrary intermediate Hold values. Ordinary Cubism interpolated opacity curves are continuous; narrow key intervals are not exact discrete semantics. Existing authored hold transitions are continuous, so do not silently relabel them discrete.",
    "manual_controls": "X/Y/rotation must target both cup representations without touching noncup meshes. Held parent may scale/rotate local translation; document actual units and measure source-pixel behavior.",
    "performance": "One extra drawable using shared texture avoids a new source image/atlas copy by API design, but hidden mesh can still incur Core deformation work. No frame-time benchmark performed."
  },
  "recommendation": "Feasible alternate representation, but incompatible with current explicit single-cup coupling assertions. Do not substitute it and call old contract passed. If root deliberately versions representation semantics, retain1px grips, noncup exact0, raw/product real Core probes and add active-cup uniqueness, switch continuity and invisible branch invariants. No current thresholds/tests modified.",
  "unchanged_thresholds": {
    "grip_source_pixels": 1,
    "finger_root_source_pixels": 0.5,
    "non_target_geometry_opacity": "exact0"
  },
  "operations_performed": "Only read-only live workspace_inspect/workspace_get_operation/workspace_list_operations and official source reads; no edit, new mesh, source, MOC or production mutation."
}
